# =========================================================
# AI Teacher - Environment Variables
# Copy this file to ".env" and paste your keys below.
# The app works with ZERO paid keys (uses free/local fallbacks),
# but quality improves a lot once you add these.
# =========================================================

# REQUIRED for smart lesson planning + adaptive teaching.
# Get a free key at https://console.groq.com  (free tier, no card needed)
GROQ_API_KEY=

# OPTIONAL - override which Groq model is used. Default is openai/gpt-oss-120b.
# If you ever see a "model_not_found" error, Groq has likely deprecated the
# current default - check https://console.groq.com/docs/models for the
# current production model list and set the new model id here.
GROQ_MODEL=

# OPTIONAL - better, more natural voice than the free gTTS fallback.
# Get a key at https://elevenlabs.io  (free tier available)
ELEVENLABS_API_KEY=

# OPTIONAL - only needed if you switch video_generator.py to call a
# premium talking-avatar API instead of the built-in local renderer.
# Get a key at https://www.heygen.com or https://www.d-id.com
HEYGEN_API_KEY=
DID_API_KEY=

# Flask secret (any random string is fine)
FLASK_SECRET_KEY=change-this-to-any-random-string
